?start: module
module: statement*

?statement: block | raw_statement

?block: define_data_block
      | find_block
      | read_block
      | histogram_block
      | if_block
      | repeat_block
      | for_block
      | decide_on_block
      | decide_for_block
      | subroutine_block
      | function_block
      | read_work_block
      | on_error_block
      | at_start_block
      | at_end_block
      | at_break_block
      | before_break_block

define_data_block: _DEFINE_DATA RAW_DATA_CONTENT? _END_DEFINE
_DEFINE_DATA: /DEFINE\s+DATA/i
_END_DEFINE: /END-DEFINE/i
RAW_DATA_CONTENT: /[\s\S]+?(?=END-DEFINE)/i

find_block: [label] _FIND raw_clause statement* _END_FIND
_FIND: /FIND/i
_END_FIND: /END-FIND/i

read_block: [label] _READ raw_clause statement* _END_READ
_READ: /READ/i
_END_READ: /END-READ/i

histogram_block: [label] _HISTOGRAM raw_clause statement* _END_HISTOGRAM
_HISTOGRAM: /HISTOGRAM\b/i
_END_HISTOGRAM: /END-HISTOGRAM\b/i

if_block: _IF raw_clause statement* (ELSE statement*)? _END_IF
_IF: /IF/i
ELSE.2: /ELSE\b/i
_END_IF: /END-IF/i

repeat_block: [label] _REPEAT raw_clause? statement* (_UNTIL raw_clause)? _END_REPEAT
_REPEAT: /REPEAT/i
_UNTIL: /UNTIL/i
_END_REPEAT: /END-REPEAT/i

for_block: [label] _FOR raw_clause statement* _END_FOR
_FOR: /FOR/i
_END_FOR: /END-FOR/i

decide_on_block: _DECIDE_ON raw_clause decide_branch* none_branch? _END_DECIDE
_DECIDE_ON: /DECIDE\s+ON/i

decide_for_block: _DECIDE_FOR decide_branch* none_branch? _END_DECIDE
_DECIDE_FOR: /DECIDE\s+FOR\s+(?:FIRST|EVERY)?\s+CONDITION[^\n]*/i

_END_DECIDE: /END-DECIDE/i

decide_branch: _VALUE raw_clause statement*
_VALUE: /(?:VALUE|WHEN)\b/i

none_branch: _NONE ["VALUE"i] statement*
_NONE: /(?:NONE|ANY)\b/i

subroutine_block: _DEFINE_SUBROUTINE SUBROUTINE_NAME statement* _END_SUBROUTINE
_DEFINE_SUBROUTINE: /DEFINE\s+SUBROUTINE/i
_END_SUBROUTINE: /END-SUBROUTINE/i
SUBROUTINE_NAME: /[A-Za-z0-9\-_]+/

function_block: _DEFINE_FUNCTION FUNCTION_NAME raw_clause? statement* _END_FUNCTION
_DEFINE_FUNCTION.2: /DEFINE\s+FUNCTION\b/i
_END_FUNCTION.2: /END-FUNCTION\b/i
FUNCTION_NAME: /[*#\+A-Za-z0-9\-_]+/

read_work_block: [label] _READ_WORK raw_clause statement* _END_WORK
_READ_WORK: /READ\s+WORK\s+FILE/i
_END_WORK: /END-WORK/i

on_error_block: _ON_ERROR statement* _END_ERROR
_ON_ERROR.3: /ON\s+ERROR\b/i
_END_ERROR.3: /END-ERROR\b/i

at_start_block: _AT_START statement* _END_START
_AT_START: /AT\s+START\s+(?:OF\s+)?DATA\b/i
_END_START: /END-START\b/i

at_end_block: _AT_END statement* _END_END
_AT_END: /AT\s+END\s+(?:OF\s+)?DATA\b/i
_END_END: /END-END\b/i

at_break_block: _AT_BREAK raw_clause statement* _END_BREAK
_AT_BREAK: /AT\s+BREAK\b/i

before_break_block: _BEFORE_BREAK statement* _END_BREAK
_BEFORE_BREAK: /BEFORE\s+BREAK(?:\s+PROCESSING)?\b/i
_END_BREAK: /END-BREAK\b/i

label: /[A-Za-z0-9\-_]+\./

raw_statement: /(?!(?i:\s*(?:END-(?:FIND|IF|REPEAT|FOR|READ|HISTOGRAM|DEFINE|DECIDE|SUBROUTINE|FUNCTION|WORK|ERROR|START|END|BREAK)|UNTIL|ELSE|FIND|IF|REPEAT|FOR|READ|HISTOGRAM|DEFINE|DECIDE|VALUE|WHEN|NONE|ANY|ON\s+ERROR|AT\s+START|AT\s+END|AT\s+BREAK|BEFORE\s+BREAK)\b))[^\n]+/
raw_clause: /[^\n]+/

%import common.WS
%ignore WS
%ignore /^\s*\*.*/m
%ignore /\/\*.*(\n|$)/
