?start: module
module: statement*

?statement: block | raw_statement

?block: define_data_block
      | find_block
      | read_block
      | if_block
      | repeat_block
      | for_block
      | decide_on_block
      | decide_for_block
      | subroutine_block
      | read_work_block
      | on_error_block

define_data_block: _DEFINE_DATA RAW_DATA_CONTENT? _END_DEFINE
_DEFINE_DATA: /DEFINE\s+DATA/i
_END_DEFINE: /END-DEFINE/i
RAW_DATA_CONTENT: /[\s\S]+?(?=END-DEFINE)/i

find_block: [label] _FIND raw_clause statement* _END_FIND
_FIND: /FIND/i
_END_FIND: /END-FIND/i

read_block: [label] _READ raw_clause statement* _END_READ
_READ: /READ/i
_END_READ: /END-READ/i

if_block: _IF raw_clause statement* (ELSE statement*)? _END_IF
_IF: /IF/i
ELSE.2: /ELSE\b/i
_END_IF: /END-IF/i

repeat_block: [label] _REPEAT raw_clause? statement* (_UNTIL raw_clause)? _END_REPEAT
_REPEAT: /REPEAT/i
_UNTIL: /UNTIL/i
_END_REPEAT: /END-REPEAT/i

for_block: [label] _FOR raw_clause statement* _END_FOR
_FOR: /FOR/i
_END_FOR: /END-FOR/i

decide_on_block: _DECIDE_ON raw_clause decide_branch* none_branch? _END_DECIDE
_DECIDE_ON: /DECIDE\s+ON/i

decide_for_block: _DECIDE_FOR decide_branch* none_branch? _END_DECIDE
_DECIDE_FOR: /DECIDE\s+FOR\s+(?:FIRST|EVERY)?\s+CONDITION[^\n]*/i

_END_DECIDE: /END-DECIDE/i

decide_branch: _VALUE raw_clause statement*
_VALUE: /(?:VALUE|WHEN)\b/i

none_branch: _NONE ["VALUE"i] statement*
_NONE: /(?:NONE|ANY)\b/i

subroutine_block: _DEFINE_SUBROUTINE SUBROUTINE_NAME statement* _END_SUBROUTINE
_DEFINE_SUBROUTINE: /DEFINE\s+SUBROUTINE/i
_END_SUBROUTINE: /END-SUBROUTINE/i
SUBROUTINE_NAME: /[A-Za-z0-9\-_]+/

read_work_block: [label] _READ_WORK raw_clause statement* _END_WORK
_READ_WORK: /READ\s+WORK\s+FILE/i
_END_WORK: /END-WORK/i

on_error_block: _ON_ERROR statement* _END_ERROR
_ON_ERROR.3: /ON\s+ERROR\b/i
_END_ERROR.3: /END-ERROR\b/i

label: /[A-Za-z0-9\-_]+\./

raw_statement: /(?!(?i:\s*(?:END-(?:FIND|IF|REPEAT|FOR|READ|DEFINE|DECIDE|SUBROUTINE|WORK|ERROR)|UNTIL|ELSE|FIND|IF|REPEAT|FOR|READ|DEFINE|DECIDE|VALUE|WHEN|NONE|ANY|ON\s+ERROR)\b))[^\n]+/
raw_clause: /[^\n]+/

%import common.WS
%ignore WS
%ignore /^\s*\*.*/m
%ignore /\/\*.*(\n|$)/
