=== NATURAL ===
DEFINE DATA PARAMETER
1 #STATUS (A10)
END-DEFINE
#STATUS := 'COMPLETED'
WRITE 5T 'A' 35T 'B' / 5T 'C'

=== PYTHON ===
from natural_runtime import tab, tabulate

class IoTabulationContext:
    def __init__(self):
        self.status = ""

def execute_io_tabulation(ctx: IoTabulationContext, session):
    ctx.status = 'COMPLETED'
    print(tabulate(tab(5), 'A', tab(35), 'B'))
    print(tabulate(tab(5), 'C'))
    return ctx

=== EXECUTE ===
- input:
    status: ""
  expected:
    status: "COMPLETED"
