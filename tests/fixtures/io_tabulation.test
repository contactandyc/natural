=== NATURAL ===
DEFINE DATA PARAMETER
1 #STATUS (A10)
END-DEFINE
#STATUS := 'COMPLETED'
WRITE 5T 'A' 35T 'B' / 5T 'C'

=== PYTHON ===
class IoTabulationContext:
    def __init__(self):
        self.status = ""

def execute_io_tabulation(ctx: IoTabulationContext, session):
    ctx.status = 'COMPLETED'
    print(" " * 4 + "A" + " " * (34 - len("    A")) + "B")
    print(" " * 4 + "C")
    return ctx

=== EXECUTE ===
- input:
    status: ""
  expected:
    status: "COMPLETED"
