=== NATURAL: EMPLOYEES.ddm ===
1 AC NAME                 A  20  N N
1 AB LANG                 A   3  N (1:7)

=== NATURAL: SAMPLE.nsp ===
DEFINE DATA LOCAL
01 #OFFSET (I2) INIT<1>
01 MYVIEW VIEW OF EMPLOYEES
  02 NAME
  02 LANG (#OFFSET:#OFFSET + 5)
  02 LANG (1:1)
01 MYVIEW2 VIEW OF EMPLOYEES
  02 LANG (1:6)
END-DEFINE

READ (1) MYVIEW BY NAME STARTING FROM 'SMITH'
  WRITE 5T LANG (#OFFSET.#OFFSET:#OFFSET + 5) 35T '<== LANG (1:6) AFTER READ'
  LANG(1.1) := '***'
  #OFFSET := 2
  WRITE 5T LANG (1.1) 35T '<== LANG (1.1) AFTER TWO ASSIGNS' /
        5T LANG (#OFFSET.#OFFSET:#OFFSET + 4) 35T '<== LANG (2:6) AFTER TWO ASSIGNS'
  UPDATE
  GET MYVIEW2 *ISN
  WRITE 5T MYVIEW2.LANG (1:6) 35T '<== AFTER UPDATE AND GET' / 5T '-' (55)
  #OFFSET := 1
END-READ
END

=== PYTHON: sample.py ===
from natural_runtime import tab, tabulate
from target_orm import Employees

class SampleContext:
    def __init__(self):
        self.offset = 1

def execute_sample(ctx: SampleContext, session):
    for loop_idx, record in enumerate(session.query(Employees).filter((Employees.name >= 'SMITH')).limit(1), 1):
        loop_counter = loop_idx
        print(tabulate(tab(5), record.lang[(ctx.offset - 1)][(ctx.offset - 1):(ctx.offset + 5)], tab(35), '<== LANG (1:6) AFTER READ'))
        record.lang[0][0] = '***'
        ctx.offset = 2
        print(tabulate(tab(5), record.lang[0][0], tab(35), '<== LANG (1.1) AFTER TWO ASSIGNS'))
        print(tabulate(tab(5), record.lang[(ctx.offset - 1)][(ctx.offset - 1):(ctx.offset + 4)], tab(35), '<== LANG (2:6) AFTER TWO ASSIGNS'))
        session.flush()  # UPDATE committed for active loop
        myview2_record = session.get(Employees, record.id)
        print(tabulate(tab(5), myview2_record.lang[(1 - 1):(1 - 1) + 6], tab(35), '<== AFTER UPDATE AND GET'))
        print(tabulate(tab(5), '-------------------------------------------------------'))
        ctx.offset = 1
    return ctx

=== EXECUTE ===
- input:
    offset: 1
  records:
    - id: 1
      name: "SMITH"
      lang:
        - ["EN", "FR", "DE", "ES", "IT", "NL", "PT"]
        - ["AA", "BB", "CC", "DD", "EE", "FF", "GG"]
  expected:
    offset: 1
