=== PYTHON: target_orm.py ===
from decimal import Decimal
from sqlalchemy import Column, String, Numeric, Integer, Boolean, JSON, Date
from sqlalchemy.orm import declarative_base

Base = declarative_base()

class Customers(Base):
    __tablename__ = 'customers'

    cust_id = Column('cust-id', Integer, primary_key=True)
    name = Column('name', String(30))

class Orders(Base):
    __tablename__ = 'orders'

    order_id = Column('order-id', Integer, primary_key=True)
    amount = Column('amount', Numeric(9, 2))
