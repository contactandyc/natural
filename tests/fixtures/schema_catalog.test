from decimal import Decimal
from sqlalchemy import Column, String, Numeric, Integer, Boolean, JSON, Date
from sqlalchemy.orm import declarative_base

Base = declarative_base()

class Contracts(Base):
    __tablename__ = 'contracts'

    id = Column('id', Integer, primary_key=True)
    schedule = Column('schedule', JSON, default=lambda: {'1': {'due_yr': Decimal('0'), 'due_amt': Decimal('0')}, '2': {'due_yr': Decimal('0'), 'due_amt': Decimal('0')}})


