=== PYTHON: target_orm.py ===
from decimal import Decimal
from sqlalchemy import Column, String, Numeric, Integer, Boolean, JSON, Date
from sqlalchemy.orm import declarative_base

Base = declarative_base()

class Employees(Base):
    __tablename__ = 'employees'

    name = Column('name', String(20), primary_key=True)
    lang = Column('lang', JSON, default=lambda: {'1': '', '2': '', '3': ''})
    historic_sal = Column('historic-sal', JSON, default=lambda: {'1990': Decimal('0'), '1991': Decimal('0'), '1992': Decimal('0')})


